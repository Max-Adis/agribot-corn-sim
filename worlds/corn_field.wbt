#VRML_SIM R2025a utf8
# Champ calqué sur agribot_field.world : 7 rangs, pas 0,85 m, plants tous les 0,60 m,
# planches de 14 m. Plants à hauteur de maïs (~1,9 m). Repère ENU, Z vers le haut.

EXTERNPROTO "../protos/Agribot.proto"
EXTERNPROTO "../protos/CornPlant.proto"
EXTERNPROTO "../protos/WeedClump.proto"

WorldInfo {
  info [
    "Champ de maïs Agribot : 7 rangs de 14 m, allée centrale à y = 0,425 m."
  ]
  title "Agribot Corn Field"
  basicTimeStep 8
  coordinateSystem "ENU"
  contactProperties [
    ContactProperties {
      material1 "tire"
      material2 "soil"
      coulombFriction 1.2
      bounce 0
      bounceVelocity 0.01
      softCFM 0.0001
      bumpSound ""
      rollSound ""
      slideSound ""
    }
  ]
}

Viewpoint {
  fieldOfView 0.95
  orientation -0.073616 0.440807 0.894578 0.369119
  position -9.200 -3.600 2.600
  description "Allée du maïs"
  near 0.1
  far 80
}

Background {
  skyColor [
    0.53 0.76 0.95
  ]
}

DirectionalLight {
  direction 0.35 0.15 -1
  intensity 2.6
  ambientIntensity 0.9
  color 1 0.98 0.94
  castShadows FALSE
}
DirectionalLight {
  direction -0.25 -0.35 -0.8
  intensity 0.55
  ambientIntensity 0.35
  castShadows FALSE
}

