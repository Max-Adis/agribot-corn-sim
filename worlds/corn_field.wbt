#VRML_SIM R2023b utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "../protos/Agribot.proto"
EXTERNPROTO "../protos/CornPlant.proto"
EXTERNPROTO "../protos/WeedClump.proto"

WorldInfo {
  info [ "Modern Corn Field with Weeds for Agribot Navigation" ]
  title "Agribot Corn Field"
  basicTimeStep 16
  coordinateSystem "ENU"
}

Viewpoint {
  orientation 0.22 0.35 0.90 1.3
  position -8.5 -2.5 3.5
}

TexturedBackground {
  texture "noon_cloudy_countryside"
}

DirectionalLight {
  direction 0.6 0.3 -0.75
  intensity 3.0
  castShadows TRUE
}

Solid {
  name "ground"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.26 0.18 0.10
        roughness 0.95
      }
      geometry Plane { size 30 30 }
    }
  ]
  boundingObject Plane { size 30 30 }
}

Solid {
  name "ridge_center"
  translation 0 0 0.04
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.32 0.20 0.10 roughness 0.9 }
      geometry Box { size 14 0.22 0.08 }
    }
  ]
}
Solid {
  name "ridge_right"
  translation 0 0.85 0.04
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.32 0.20 0.10 roughness 0.9 }
      geometry Box { size 14 0.22 0.08 }
    }
  ]
}
Solid {
  name "ridge_left"
  translation 0 -0.85 0.04
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.32 0.20 0.10 roughness 0.9 }
      geometry Box { size 14 0.22 0.08 }
    }
  ]
}

# Rang gauche, y = 0
CornPlant { translation -5.5 0.0 0 }
CornPlant { translation -4.7 0.0 0 }
CornPlant { translation -3.9 0.0 0 }
CornPlant { translation -3.1 0.0 0 }
CornPlant { translation -2.3 0.0 0 }
CornPlant { translation -1.5 0.0 0 }
CornPlant { translation -0.7 0.0 0 }
CornPlant { translation  0.1 0.0 0 }
CornPlant { translation  0.9 0.0 0 }
CornPlant { translation  1.7 0.0 0 }

# Rang droit, y = 0.85
CornPlant { translation -5.5 0.85 0 }
CornPlant { translation -4.7 0.85 0 }
CornPlant { translation -3.9 0.85 0 }
CornPlant { translation -3.1 0.85 0 }
CornPlant { translation -2.3 0.85 0 }
CornPlant { translation -1.5 0.85 0 }
CornPlant { translation -0.7 0.85 0 }
CornPlant { translation  0.1 0.85 0 }
CornPlant { translation  0.9 0.85 0 }
CornPlant { translation  1.7 0.85 0 }

# Adventices entre les rangs et dans l'allée
WeedClump { translation -5.10  0.35 0 }
WeedClump { translation -4.85  0.52 0 }
WeedClump { translation -4.30  0.28 0 }
WeedClump { translation -3.75  0.44 0 }
WeedClump { translation -3.40  0.58 0 }
WeedClump { translation -2.90  0.32 0 }
WeedClump { translation -2.45  0.48 0 }
WeedClump { translation -1.90  0.38 0 }
WeedClump { translation -1.35  0.52 0 }
WeedClump { translation -0.80  0.40 0 }
WeedClump { translation -0.20  0.45 0 }
WeedClump { translation  0.40  0.30 0 }
WeedClump { translation  1.10  0.50 0 }
WeedClump { translation -5.20 -0.45 0 }
WeedClump { translation -4.60 -0.38 0 }
WeedClump { translation -3.80 -0.50 0 }
WeedClump { translation -2.95 -0.40 0 }
WeedClump { translation -2.10 -0.46 0 }
WeedClump { translation -5.10  1.25 0 }
WeedClump { translation -4.40  1.32 0 }
WeedClump { translation -3.60  1.22 0 }
WeedClump { translation -2.75  1.30 0 }

# Début de l'allée centrale. z = 0 : les roues (rayon 8,25 cm) touchent le sol.
Agribot {
  translation -5.5 0.425 0
  rotation 0 0 1 0
}
